# ==============================================================================
# VayoCare Production & Staging Environment Configuration
# ==============================================================================

# Core Project Settings
PROJECT_NAME="VayoCare"
PROJECT_VERSION="2.1.0"
HOST="0.0.0.0"
PORT=8000
PUBLIC_BASE_URL="http://localhost:8000"

# Demo Mode (Set to false in production to prevent seeding Ramesh Rao demo profile)
DEMO_MODE=true

# Database Persistence (PostgreSQL on Neon/Supabase/Render, SQLite for local dev)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL="sqlite:///./vayocare.db"

# Google Gemini AI Integration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# JWT & Passcode Security
JWT_SECRET="vayocare_super_secure_jwt_secret_key_change_me_in_prod"
JWT_ALGORITHM="HS256"
JWT_EXPIRES_DAYS=30
ROLLING_PIN_SALT="vayocare_rolling_pin_security_salt_2026"

# Storage Configuration (local, s3, supabase, cloudinary)
STORAGE_TYPE="local"
STORAGE_LOCAL_DIR="uploads"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
CLOUDINARY_URL=""

# Proactive Email Alerting & SMTP Engine
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD=""
SMTP_FROM="alerts@vayocare.health"

# Web Push (VAPID) Settings
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBKr3qBUYhHBQFLXYp5NMPH84"
VAPID_PRIVATE_KEY=""
VAPID_CLAIMS_EMAIL="admin@vayocare.health"

# Allowed CORS Origins (comma-separated list)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://0.0.0.0:8000"
